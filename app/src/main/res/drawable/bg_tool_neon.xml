<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle"><solid android:color="#1FFF8A1E"/><stroke android:width="1dp" android:color="#FFFF8A1E"/><corners android:radius="12dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#18FF8A1E"/><stroke android:width="1dp" android:color="#99FF8A1E"/><corners android:radius="12dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#0D1118"/><stroke android:width="1dp" android:color="#24FFFFFF"/><corners android:radius="12dp"/></shape>
    </item>
</selector>
