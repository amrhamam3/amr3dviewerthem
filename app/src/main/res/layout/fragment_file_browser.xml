<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- شريط المسار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/surface_dark"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackDir"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_history"
            android:background="@android:color/transparent"
            android:tint="@color/accent_orange"
            android:contentDescription="رجوع"
            android:padding="8dp"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/currentPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/formatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧊 STL · 📐 DXF"
            android:textColor="@color/accent_orange"
            android:textSize="10sp"
            android:background="#1AFF8A1E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="6dp" />

        <!-- زرار طي/إظهار لوحة فلترة الصيغ — نفس شكل وسلوك btnToggleToolbars في
             شاشة العارض الأساسية بالظبط (سهم بيلف 180° لما يتفتح) -->
        <Button
            android:id="@+id/btnToggleFormatFilter"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⌄"
            android:textSize="14sp"
            android:textColor="@color/accent_orange" />

    </LinearLayout>

    <!-- لوحة فلترة الصيغ — مطوية افتراضيًا -->
    <LinearLayout
        android:id="@+id/formatFilterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_row"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox android:id="@+id/cbFilterStl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧊 STL" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" android:layout_marginEnd="10dp" />
            <CheckBox android:id="@+id/cbFilterObj" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧊 OBJ" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" android:layout_marginEnd="10dp" />
            <CheckBox android:id="@+id/cbFilterGlb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧊 GLB" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <CheckBox android:id="@+id/cbFilterDxf" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📐 DXF" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" android:layout_marginEnd="10dp" />
            <CheckBox android:id="@+id/cbFilterAi" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📐 AI" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" android:layout_marginEnd="10dp" />
            <CheckBox android:id="@+id/cbFilterPdf" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📐 PDF" android:textColor="@color/text_primary" android:textSize="12sp"
                android:buttonTint="@color/accent_orange" android:checked="true" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1AFFFFFF" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/filterMatchCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnFilterSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الكل"
                android:textColor="@color/accent_orange"
                android:textSize="11sp"
                android:padding="6dp" />

            <TextView
                android:id="@+id/btnFilterClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مسح"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:padding="6dp"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- شريط البحث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_settings_row"
        android:layout_margin="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/files_search_hint"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/browserProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:progressTint="@color/accent_orange"
        android:visibility="gone" />

    <!-- قائمة الملفات -->
    <ListView
        android:id="@+id/fileList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true" />

</LinearLayout>
