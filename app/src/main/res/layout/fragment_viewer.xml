<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Futuristic HUD Header: no logic changed, existing IDs preserved. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_topbar_futuristic"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="38dp" android:layout_height="38dp"
            android:src="@drawable/app_logo"
            android:contentDescription="@string/app_name"
            android:background="@drawable/bg_tool_chip"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AMR3D PREVIEW PRO" android:textColor="@color/text_primary"
                android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent_orange" android:textSize="9sp"
                android:letterSpacing="0.08" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end" android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3D MODEL" android:textColor="#66717F" android:textSize="7sp" android:letterSpacing="0.12"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="READY" android:textColor="@color/accent_orange" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnWhatsapp"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_whatsapp"
            android:contentDescription="واتساب" android:padding="8dp" />

        <TextView
            android:id="@+id/btnToggleDxf"
            android:layout_width="50dp" android:layout_height="40dp"
            android:layout_marginStart="7dp" android:background="@drawable/bg_dxf_button_futuristic"
            android:gravity="center" android:text="2D" android:textColor="@color/accent_orange"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/toggle_dxf_view" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/viewerContainer"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <com.amr3d.preview.pro.GLViewerView
            android:id="@+id/glViewerView" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.amr3d.preview.pro.ParticleFieldView
            android:id="@+id/particleField" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false" />
        <com.amr3d.preview.pro.PivotFeedbackView
            android:id="@+id/pivotFeedbackView" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false" />
        <com.amr3d.preview.pro.DXF2DView
            android:id="@+id/dxf2DView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dxfGapCard" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp"
            android:background="@drawable/bg_floating_hud" android:elevation="10dp" android:padding="3dp" android:visibility="gone">
            <CheckBox android:id="@+id/cbHighlightDxfGaps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="6dp" android:buttonTint="@color/accent_orange" android:text="@string/dxf_highlight_gaps"
                android:textColor="@color/text_primary" android:textSize="11sp" />
        </LinearLayout>

        <!-- compact HUD stats -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_stats_futuristic"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GEOMETRY STATUS" android:textColor="#596572" android:textSize="7sp" android:letterSpacing="0.12"/>
            <TextView android:id="@+id/modelStatsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_orange" android:textSize="9sp" android:fontFamily="monospace" android:gravity="center" android:lineSpacingExtra="1dp" android:clickable="false" android:focusable="false" android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyStateText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="@string/no_file_loaded" android:textColor="@color/text_secondary"
            android:textSize="15sp" android:gravity="center" android:lineSpacingExtra="4dp" />

        <!-- Direction HUD -->
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_marginStart="12dp" android:layout_marginTop="78dp">
            <Button android:id="@+id/btnDirections" style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp" android:text="✦" android:textSize="18sp"
                android:textColor="@color/accent_orange" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/bg_direction_futuristic" android:elevation="8dp" />
            <FrameLayout android:id="@+id/directionsPanel" android:layout_width="138dp" android:layout_height="138dp"
                android:layout_marginTop="56dp" android:layoutDirection="ltr" android:background="@drawable/bg_floating_hud"
                android:elevation="12dp" android:visibility="gone">
                <ImageView android:id="@+id/compassRing" android:layout_width="98dp" android:layout_height="98dp" android:layout_gravity="center" android:src="@drawable/bg_compass_ring" />
                <Button android:id="@+id/btnViewTop" style="@style/Widget.MaterialComponents.Button" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="52dp" android:layout_marginTop="5dp" android:text="↑" android:textSize="11sp" android:textColor="@color/text_primary" android:background="@drawable/bg_compass_button" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
                <Button android:id="@+id/btnViewLeft" style="@style/Widget.MaterialComponents.Button" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:layout_marginTop="52dp" android:text="←" android:textSize="11sp" android:textColor="@color/text_primary" android:background="@drawable/bg_compass_button" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
                <Button android:id="@+id/btnViewRight" style="@style/Widget.MaterialComponents.Button" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="99dp" android:layout_marginTop="52dp" android:text="→" android:textSize="11sp" android:textColor="@color/text_primary" android:background="@drawable/bg_compass_button" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
                <Button android:id="@+id/btnViewBottom" style="@style/Widget.MaterialComponents.Button" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="52dp" android:layout_marginTop="99dp" android:text="↓" android:textSize="11sp" android:textColor="@color/text_primary" android:background="@drawable/bg_compass_button" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
                <Button android:id="@+id/btnViewBack" style="@style/Widget.MaterialComponents.Button" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="101dp" android:layout_marginTop="101dp" android:text="B" android:textSize="8sp" android:textColor="@color/text_primary" android:background="@drawable/bg_compass_button" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" />
                <Button android:id="@+id/btnViewFront" style="@style/Widget.MaterialComponents.Button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="48dp" android:layout_marginTop="48dp" android:text="F" android:textSize="10sp" android:textColor="#1a0e02" android:textStyle="bold" android:background="@drawable/bg_compass_center" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:elevation="2dp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout android:id="@+id/loadingContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="@drawable/bg_floating_hud" android:padding="14dp" android:visibility="gone">
            <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_orange" android:textSize="12sp" android:gravity="center" android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp" />
            <ProgressBar android:id="@+id/loadingProgress" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="0" android:progressTint="@color/accent_orange" android:progressBackgroundTint="#2A2D35" />
        </LinearLayout>

        <TextView android:id="@+id/welcomeOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" android:background="#BB000000" android:visibility="gone" />

        <androidx.cardview.widget.CardView android:id="@+id/measurementCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="14dp" android:layout_marginBottom="176dp" app:cardBackgroundColor="#E60A0D13" app:cardCornerRadius="16dp" app:cardElevation="10dp" android:visibility="gone">
            <TextView android:id="@+id/measurementText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/accent_blue" android:textSize="13sp" android:fontFamily="monospace" />
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btnToggleToolbars" style="@style/Widget.MaterialComponents.Button" android:layout_width="54dp" android:layout_height="28dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="156dp" android:text="⌄" android:textSize="14sp" android:textColor="@color/accent_orange" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/bg_direction_futuristic" android:elevation="8dp" android:contentDescription="طي أو إظهار شرائط الأدوات" />

        <LinearLayout android:id="@+id/inspectionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="166dp" android:background="@drawable/bg_dialog_panel" android:elevation="10dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/inspectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace" android:lineSpacingExtra="4dp" />
            <CheckBox android:id="@+id/cbHighlightOpenEdges" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp" android:buttonTint="@color/accent_orange" android:text="@string/inspection_highlight_open_edges" android:textColor="@color/text_primary" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>

        <com.amr3d.preview.pro.LightDialOverlayView android:id="@+id/lightDialOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <ImageButton android:id="@+id/btnCloseLightWheel" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="top|end" android:layout_margin="12dp" android:background="@drawable/bg_tool_neon" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#CCCCCC" android:visibility="gone" android:contentDescription="إغلاق" />

        <!-- Floating display dock -->
        <LinearLayout android:id="@+id/displayToolbar" android:layout_width="match_parent" android:layout_height="82dp" android:layout_gravity="bottom" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="94dp" android:orientation="horizontal" android:gravity="center" android:padding="7dp" android:background="@drawable/bg_toolbar_dock" android:elevation="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/btnWireframe" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_wireframe_glyph" android:tint="@color/accent_orange" android:contentDescription="@string/wireframe" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIRE" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.08" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/btnMaterial" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_material_palette" android:tint="@color/accent_orange" android:contentDescription="@string/material" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MATERIAL" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.05" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <Button android:id="@+id/btnUnit" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="48dp" android:layout_height="44dp" android:text="MM" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/accent_orange" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:background="@drawable/bg_tool_neon" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNIT" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.08" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/btnExport" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_camera_export" android:tint="@color/accent_orange" android:contentDescription="@string/export_image" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAPTURE" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.05" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/btnLightToggle" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_light_bulb" android:tint="@color/accent_orange" android:contentDescription="@string/light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIGHT" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating action dock -->
        <LinearLayout android:id="@+id/bottomToolbar" android:layout_width="match_parent" android:layout_height="82dp" android:layout_gravity="bottom" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="6dp" android:orientation="horizontal" android:gravity="center" android:padding="7dp" android:background="@drawable/bg_toolbar_dock" android:elevation="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/btnAutoRotate" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_rotate" android:tint="@color/accent_orange" android:contentDescription="تدوير تلقائي"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROTATE" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.07"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/btnMeasureTool" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_measure_ruler" android:tint="@color/accent_orange" android:contentDescription="@string/measure_tool"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEASURE" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.03"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/btnInspect" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_inspect" android:tint="@color/accent_orange" android:contentDescription="@string/inspect_tool"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INSPECT" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.05"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/btnResetView" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_reset_view" android:tint="@color/accent_orange" android:contentDescription="@string/reset_view"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESET" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.08"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><ImageButton android:id="@+id/btnBoundingBox" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:background="@drawable/bg_tool_neon" android:src="@drawable/ic_bounding_box" android:tint="@color/accent_orange" android:contentDescription="صندوق الأبعاد"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOUNDS" android:textColor="#7D8793" android:textSize="7sp" android:letterSpacing="0.06"/></LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
